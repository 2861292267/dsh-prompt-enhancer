{
  "name": "@local/dsh-prompt-forge",
  "displayName": "DSH Prompt Enhancer",
  "description": "Bring WorkBuddy's 增强提示词 (Enhance Prompt) button to DeepSeek Harness: rewrite the composer draft into a stronger, better-structured prompt with one click, with a /enhance slash command for the keyboard path.",
  "version": "1.4.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "prompt-engineering",
    "enhance",
    "workbuddy"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
